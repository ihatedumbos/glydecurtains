# ============================
# Glyde Curtains - Environment Variables
# ============================
# Copy this file to .env and update values for your environment.

# --- Application ---
SPRING_PROFILES_ACTIVE=int          # Options: int, qa, prod

# --- Server Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Database (H2 embedded - no external config needed) ---
# H2 runs in-memory by default; data resets on restart.

# --- Logging ---
LOG_LEVEL=INFO                      # Options: DEBUG, INFO, WARN, ERROR

# --- Application Settings ---
SEED_DATA=true                      # Seed demo data on startup (disable in prod)
