# Glyde Curtains local environment variables
# Copy or adapt values for Render / Docker / local development.

# Backend app
SPRING_PROFILES_ACTIVE=int
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend app
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=Glyde Curtains

# Docker / local stack
BACKEND_PORT=8080
FRONTEND_PORT=80

# Logging
LOG_LEVEL=INFO

# App behavior
SEED_DATA=true

# JWT / legacy support values retained for current app compatibility
JWT_SECRET=glydecurtains-dev-secret-key-change-in-production-min-256-bits
APP_JWT_SECRET=glydecurtains-dev-secret-key-change-in-production-min-256-bits
